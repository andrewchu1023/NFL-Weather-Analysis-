# -------------------------------
# GCP / Spark / GCS
# -------------------------------
# Path to service-account JSON key (optional if using gcloud ADC login)
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# Optional override if your Spark environment needs a specific GCS connector coordinate
SPARK_GCS_CONNECTOR=com.google.cloud.bigdataoss:gcs-connector:hadoop3-2.2.28

# -------------------------------
# Snowflake (required only when using --with-snowflake)
# -------------------------------
SNOWFLAKE_ACCOUNT=ekbpfux-vob93769
SNOWFLAKE_ACCOUNT_FALLBACK=hbb86970
SNOWFLAKE_USER=YOUR_USER
SNOWFLAKE_PASSWORD=YOUR_PASSWORD
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=NFL_WEATHER
SNOWFLAKE_STORAGE_INTEGRATION=GCS_NFL_WEATHER_INT

# Optional authenticator (e.g., externalbrowser/okta)
# SNOWFLAKE_AUTHENTICATOR=externalbrowser

# Optional if you need to override stage URL during phase1
# GCS_SERVING_URL=gcs://msba405-nfl-weather-raw/gold/tableau_serving/v1/
